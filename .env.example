# ChequeCerto — copie para `.env.local` (dev) e configure as mesmas variáveis na Vercel.

# ---------------------------------------------------------------------------
# Supabase — Dashboard > Project Settings > API Keys
#
# O Supabase renomeou as chaves. Use o par que o SEU projeto mostrar:
#   projeto novo  → sb_publishable_... / sb_secret_...
#   projeto antigo → anon key (JWT) / service_role key (JWT)
# O app aceita os dois nomes de variável, então basta preencher um de cada par.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública: vai para o browser de propósito, quem protege os dados é a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa em projeto antigo:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave de serviço: IGNORA RLS, usada só no servidor (jobs/webhooks futuros).
# NUNCA prefixe com NEXT_PUBLIC_ e nunca importe em componente client.
SUPABASE_SECRET_KEY=
# Alternativa em projeto antigo:
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Modelo de visão (a chave fica só no servidor, igual ao MatchCV)
# VISION_PROVIDER: "gemini" (padrão, melhor OCR de manuscrito) ou "groq"
# ---------------------------------------------------------------------------
VISION_PROVIDER=gemini

# gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# groq — https://console.groq.com/keys (precisa ser um modelo com visão)
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
