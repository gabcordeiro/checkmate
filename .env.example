# ChequeCerto — copie para `.env.local` (dev) e configure as mesmas variáveis na Vercel.

# ---------------------------------------------------------------------------
# Supabase — Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key

# Usada SÓ no servidor (jobs/webhooks que precisam ignorar RLS).
# NUNCA prefixe com NEXT_PUBLIC_ e nunca importe em componente client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Modelo de visão (a chave fica só no servidor, igual ao MatchCV)
# VISION_PROVIDER: "gemini" (padrão, melhor OCR de manuscrito) ou "groq"
# ---------------------------------------------------------------------------
VISION_PROVIDER=gemini

# gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# groq — https://console.groq.com/keys (precisa ser um modelo com visão)
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
